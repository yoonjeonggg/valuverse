# 이 파일을 복사해 .env 로 만들고 값을 채우세요.  (.env 는 git 에 커밋되지 않습니다)
#   cp .env.example .env

# JWT 서명 키 - 아래 명령으로 생성한 값을 넣으세요.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# JWT 알고리즘 / 토큰 만료(분)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 데이터베이스 접속 URL
DATABASE_URL=sqlite:///./auction.db

# CORS 허용 오리진 (쉼표로 구분) - 프론트엔드 주소
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 경매 자동 연장(스나이핑 방지) - 마감 N초 이내 입찰 시 M초 연장, 최대 K회
AUCTION_EXTEND_WINDOW_SECONDS=180
AUCTION_EXTEND_BY_SECONDS=180
AUCTION_MAX_EXTENSIONS=10
